// SafeConfig - Minimal Schema
// Only the 5 core entities for configuration management

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CORE ENTITIES
// ============================================

model Organization {
  id   String           @id @db.Uuid
  name String           @db.VarChar(255)
  plan OrganizationPlan @default(FREE)

  // Relations
  members             UserOrganization[]
  apps                App[]
  environments        Environment[]
  invites             OrgInvite[]
  auditEvents         AuditEvent[]
  identities          Identity[]
  roles               Role[]
  billingCustomer     BillingCustomer?
  billingSubscription BillingSubscription?
  billingEvents        BillingEvent[]

  @@map("organizations")
}

model App {
  id       String  @id @db.Uuid
  orgId    String  @map("org_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name     String  @db.VarChar(255)

  // Hierarchy optimization (path materialization)
  ancestors String[] @default([]) @db.Uuid // [root_id, ..., parent_id] - excludes itself
  depth     Int      @default(0) // 0=root, 1=child, etc. (useful for queries and validation)

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent       App?         @relation("AppHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children     App[]        @relation("AppHierarchy") // Inverse relation (optional but convenient)
  parameters   Parameter[]
  accessKeys   AccessKey[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([parentId])
  @@index([ancestors], type: Gin) // For fast hierarchy queries
  @@map("apps")
}

model Environment {
  id        String          @id @db.Uuid
  orgId     String          @map("org_id") @db.Uuid
  name      String          @db.VarChar(100)
  tier      EnvironmentTier @default(CUSTOM)
  protected Boolean         @default(false)

  // Relations
  organization           Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parameterValues        ParameterValue[]
  parameterValueVersions ParameterValueVersion[]
  accessKeys             AccessKey[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("environments")
}

model Parameter {
  id          String  @id @db.Uuid
  appId       String  @map("app_id") @db.Uuid
  key         String  @db.VarChar(255)
  description String? @db.Text

  // Relations
  app      App                     @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  values   ParameterValue[]
  versions ParameterValueVersion[]

  @@unique([appId, key])
  @@index([appId])
  @@map("parameters")
}

model ParameterValue {
  id            String @id @db.Uuid
  parameterId   String @map("parameter_id") @db.Uuid
  environmentId String @map("environment_id") @db.Uuid

  valueCiphertext Bytes    @map("value_ciphertext")
  valueIv         Bytes    @map("value_iv")
  valueTag        Bytes    @map("value_tag")
  dekCiphertext   Bytes    @map("dek_ciphertext")
  dekIv           Bytes    @map("dek_iv")
  dekTag          Bytes    @map("dek_tag")
  kekVersion      Int      @map("kek_version")
  encryptionAlg   String   @default("AES-256-GCM") @map("encryption_alg")
  encryptedAt     DateTime @map("encrypted_at")
  isSet           Boolean  @default(false) @map("is_set")

  // Relations
  parameter   Parameter               @relation(fields: [parameterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  environment Environment             @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versions    ParameterValueVersion[]

  @@unique([parameterId, environmentId])
  @@index([parameterId])
  @@index([environmentId])
  @@map("parameter_values")
}

model ParameterValueVersion {
  id               String @id @db.Uuid
  parameterValueId String @map("parameter_value_id") @db.Uuid
  parameterId      String @map("parameter_id") @db.Uuid
  environmentId    String @map("environment_id") @db.Uuid
  createdByUserId  String @map("created_by_user_id") @db.Uuid

  versionNumber Int                      @map("version_number")
  changeType    ParameterValueChangeType @map("change_type")

  rolledBackFromVersionId String? @map("rolled_back_from_version_id") @db.Uuid

  valueCiphertext Bytes    @map("value_ciphertext")
  valueIv         Bytes    @map("value_iv")
  valueTag        Bytes    @map("value_tag")
  dekCiphertext   Bytes    @map("dek_ciphertext")
  dekIv           Bytes    @map("dek_iv")
  dekTag          Bytes    @map("dek_tag")
  kekVersion      Int      @map("kek_version")
  encryptionAlg   String   @default("AES-256-GCM") @map("encryption_alg")
  encryptedAt     DateTime @map("encrypted_at")
  isSet           Boolean  @default(false) @map("is_set")

  createdAt DateTime @default(now()) @map("created_at")

  parameterValue ParameterValue          @relation(fields: [parameterValueId], references: [id], onDelete: Cascade)
  parameter      Parameter               @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  environment    Environment             @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdByUser  User                    @relation(fields: [createdByUserId], references: [id])
  rolledBackFrom ParameterValueVersion?  @relation("RollbackSource", fields: [rolledBackFromVersionId], references: [id])
  rollbackCopies ParameterValueVersion[] @relation("RollbackSource")

  @@unique([parameterValueId, versionNumber])
  @@index([parameterValueId, createdAt])
  @@index([parameterId, environmentId])
  @@map("parameter_value_versions")
}

// ============================================
// AUTHENTICATION
// ============================================

model User {
  id          String  @id @default(uuid()) @db.Uuid
  supabaseId  String  @unique @map("supabase_id") @db.VarChar(255)
  email       String  @unique @db.VarChar(255)
  displayName String? @map("display_name") @db.VarChar(255)

  // Relations
  organizations          UserOrganization[]
  sentInvites            OrgInvite[]             @relation("SentInvites")
  parameterValueVersions ParameterValueVersion[]
  auditEvents            AuditEvent[]
  ownedIdentities        Identity[]              @relation("IdentityOwner")
  createdAccessKeys      AccessKey[]             @relation("AccessKeyCreator")
  createdRoles           Role[]                  @relation("RoleCreator")

  @@index([supabaseId])
  @@index([email])
  @@map("users")
}

model UserOrganization {
  userId String @map("user_id") @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, orgId])
  @@index([userId])
  @@index([orgId])
  @@index([roleId])
  @@map("user_organizations")
}

model OrgInvite {
  id         String       @id @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  email      String       @db.VarChar(255)
  roleId     String       @map("role_id") @db.Uuid
  tokenHash  String       @unique @map("token_hash") @db.VarChar(64)
  invitedBy  String       @map("invited_by") @db.Uuid
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime     @map("expires_at")
  resolvedAt DateTime?    @map("resolved_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter User         @relation("SentInvites", fields: [invitedBy], references: [id])
  role    Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([roleId])
  @@index([tokenHash])
  @@map("org_invites")
}

model Role {
  id              String   @id @db.Uuid
  orgId           String?  @map("org_id") @db.Uuid
  key             String   @db.VarChar(100)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  kind            RoleKind @default(CUSTOM)
  permissions     Json    @default("[]")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  org            Organization?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdByUser  User?              @relation("RoleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  memberships    UserOrganization[]
  invites        OrgInvite[]

  @@unique([orgId, key])
  @@index([orgId])
  @@index([createdByUserId])
  @@map("roles")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum OrganizationPlan {
  FREE
  TEAM
  BUSINESS
  ENTERPRISE
}

enum BillingProvider {
  PADDLE
  STRIPE
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

model BillingCustomer {
  id                 String          @id @db.Uuid
  orgId              String          @unique @map("org_id") @db.Uuid
  provider           BillingProvider
  providerCustomerId String          @map("provider_customer_id") @db.VarChar(255)
  billingEmail       String?         @map("billing_email") @db.VarChar(255)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([provider, providerCustomerId])
  @@index([orgId])
  @@map("billing_customers")
}

model BillingSubscription {
  id                     String                    @id @db.Uuid
  orgId                  String                    @unique @map("org_id") @db.Uuid
  provider               BillingProvider
  providerSubscriptionId String                    @map("provider_subscription_id") @db.VarChar(255)
  providerPriceId        String                    @map("provider_price_id") @db.VarChar(255)
  plan                   OrganizationPlan
  status                 BillingSubscriptionStatus
  currentPeriodStart     DateTime?                 @map("current_period_start")
  currentPeriodEnd       DateTime?                 @map("current_period_end")
  cancelAtPeriodEnd      Boolean                   @default(false) @map("cancel_at_period_end")
  trialEndsAt            DateTime?                 @map("trial_ends_at")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubscriptionId])
  @@index([orgId])
  @@map("billing_subscriptions")
}

model BillingEvent {
  providerEventId String          @id @map("provider_event_id") @db.VarChar(255)
  orgId           String?         @map("org_id") @db.Uuid
  provider        BillingProvider
  type            String          @db.VarChar(100)
  processedAt     DateTime        @default(now()) @map("processed_at")

  org Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([provider, type])
  @@map("billing_events")
}

enum ParameterValueChangeType {
  UPDATE
  CLEAR
  ROLLBACK
}

model AuditEvent {
  id           String         @id @db.Uuid
  orgId        String         @map("org_id") @db.Uuid
  actorUserId  String?        @map("actor_user_id") @db.Uuid
  actorType    AuditActorType @default(USER) @map("actor_type")
  actorDisplay String?        @map("actor_display") @db.VarChar(255)

  action        String       @db.VarChar(100)
  resourceType  String       @map("resource_type") @db.VarChar(100)
  resourceId    String?      @map("resource_id") @db.VarChar(255)
  resourceLabel String?      @map("resource_label") @db.VarChar(255)
  outcome       AuditOutcome @default(SUCCESS)

  requestId String? @map("request_id") @db.VarChar(255)
  ip        String? @db.VarChar(255)
  userAgent String? @map("user_agent") @db.Text
  metadata  Json    @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, action, createdAt])
  @@index([orgId, resourceType, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

enum AuditActorType {
  USER
  API_TOKEN
  SYSTEM
  ANONYMOUS
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum RoleKind {
  SYSTEM
  CUSTOM
}

enum EnvironmentTier {
  DEVELOPMENT
  STAGING
  PRODUCTION
  CUSTOM
}

model Identity {
  id          String       @id @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  type        IdentityType
  name        String       @db.VarChar(255)
  ownerUserId String?      @map("owner_user_id") @db.Uuid
  disabledAt  DateTime?    @map("disabled_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerUser  User?        @relation("IdentityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  accessKeys AccessKey[]

  @@index([orgId])
  @@index([ownerUserId])
  @@map("identities")
}

model AccessKey {
  id              String    @id @db.Uuid
  identityId      String    @map("identity_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  name            String    @db.VarChar(255)
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  tokenPrefix     String    @map("token_prefix") @db.VarChar(128)
  scopes          String[]  @default([])
  appId           String?   @map("app_id") @db.Uuid
  environmentId   String?   @map("environment_id") @db.Uuid
  expiresAt       DateTime? @map("expires_at")
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  identity      Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)
  createdByUser User         @relation("AccessKeyCreator", fields: [createdByUserId], references: [id])
  app           App?         @relation(fields: [appId], references: [id], onDelete: Cascade)
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([createdByUserId])
  @@index([appId])
  @@index([environmentId])
  @@index([tokenHash])
  @@map("access_keys")
}

enum IdentityType {
  USER
  SERVICE
}
