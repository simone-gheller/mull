// SafeConfig - Minimal Schema
// Only the 5 core entities for configuration management

generator client {
  provider = "prisma-client-js"
  engineType = "client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CORE ENTITIES
// ============================================

model Organization {
  id   String @id @db.Uuid
  name String @db.VarChar(255)

  // Relations
  users        User[]
  apps         App[]
  environments Environment[]

  @@map("organizations")
}

model App {
  id       String  @id @db.Uuid
  orgId    String  @map("org_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name     String  @db.VarChar(255)

  // Hierarchy optimization (path materialization)
  ancestors String[] @default([]) @db.Uuid // [root_id, ..., parent_id] - excludes itself
  depth     Int      @default(0)  // 0=root, 1=child, etc. (useful for queries and validation)

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent       App?         @relation("AppHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children     App[]        @relation("AppHierarchy") // Inverse relation (optional but convenient)
  parameters   Parameter[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([parentId])
  @@index([ancestors], type: Gin) // For fast hierarchy queries
  @@map("apps")
}

model Environment {
  id    String @id @db.Uuid
  orgId String @map("org_id") @db.Uuid
  name  String @db.VarChar(100)

  // Relations
  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parameterValues ParameterValue[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("environments")
}

model Parameter {
  id    String @id @db.Uuid
  appId String @map("app_id") @db.Uuid
  key   String @db.VarChar(255)

  // Relations
  app    App              @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  values ParameterValue[]

  @@unique([appId, key])
  @@index([appId])
  @@map("parameters")
}

model ParameterValue {
  id            String @id @db.Uuid
  parameterId   String @map("parameter_id") @db.Uuid
  environmentId String @map("environment_id") @db.Uuid
  value         String @db.Text // Plain text (encryption optional for later)

  // Relations
  parameter   Parameter   @relation(fields: [parameterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([parameterId, environmentId])
  @@index([parameterId])
  @@index([environmentId])
  @@map("parameter_values")
}

// ============================================
// AUTHENTICATION
// ============================================

model User {
  id             String        @id @default(uuid()) @db.Uuid
  supabaseId     String        @unique @map("supabase_id") @db.VarChar(255)
  email          String        @unique @db.VarChar(255)
  displayName    String?       @db.VarChar(255) @map("display_name")
  role           UserRole      @default(USER)
  organizationId String?       @map("organization_id") @db.Uuid

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([supabaseId])
  @@index([email])
  @@index([organizationId])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  OWNER
}
