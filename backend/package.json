{
  "name": "safeconfig",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --env-file=.env tests/utils/integrationPreflight.js && node --env-file=.env --test tests/integration/**/*.test.js",
    "test:all": "npm run test:unit && npm run test:integration",
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "start:prod": "node src/server.js",
    "supabase:start": "cd .. && npx supabase start",
    "supabase:stop": "cd .. && npx supabase stop",
    "supabase:status": "cd .. && npx supabase status",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:reset": "npx prisma migrate reset",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:backfill:is-set": "node --env-file=.env scripts/backfill-parameter-value-is-set.js"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/env": "^6.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/passport": "^3.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/secure-session": "^8.2.0",
    "@fastify/session": "^11.1.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.2.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "bcrypt": "^6.0.0",
    "crypto": "^1.0.1",
    "fastify": "^5.6.1",
    "get-jwks": "^11.0.3",
    "googleapis": "^159.0.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.2.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.17.2",
    "prisma": "^7.2.0",
    "redis": "^5.8.2",
    "uuidv7": "^1.1.0"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.5",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.1",
    "supabase": "^2.72.0",
    "supertest": "^7.1.4"
  }
}
