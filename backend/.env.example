# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Authentication
# Get this from Supabase Dashboard > Settings > API > JWT Secret
# For local development with Supabase CLI, run: npx supabase status
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Supabase Configuration (for reference)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here

# Logging
LOG_LEVEL=info

# Optional: Redis (if using caching)
REDIS_URL=redis://localhost:6379

# Optional: Google OAuth (if using Google authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Supabase Auth external providers (used by supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=your-github-client-id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=your-github-client-secret
