// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String              @id @default(uuid())
  email                 String              @unique
  passwordHash          String?             // Make nullable for Google users
  authProvider          AuthProvider        @default(PASSWORD)
  googleId              String?             @unique
  displayName           String?             
  workspaceMemberships  WorkspaceMember[]
  createdWorkspaces     Workspace[]         @relation("WorkspaceCreator")
  createdInvites        WorkspaceInvite[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt @default(now())
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

model Workspace {
  id              String              @id @default(uuid())
  name            String
  slug            String              @unique
  type            WorkspaceType       @default(TEAM)
  plan            WorkspacePlan       @default(FREE)
  allowedDomains  String[]            // Array of allowed email domains
  createdBy       String
  creator         User                @relation("WorkspaceCreator", fields: [createdBy], references: [id])
  members         WorkspaceMember[]
  invites         WorkspaceInvite[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  joinedVia   JoinMethod    @default(INVITED)
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String?       // Email for specific invites
  code        String        @unique // Unique invite code
  role        WorkspaceRole @default(MEMBER)
  maxUses     Int?          // Max uses for link invites
  uses        Int           @default(0)
  expiresAt   DateTime?     // Optional expiration
  createdBy   String
  creator     User          @relation(fields: [createdBy], references: [id])
  createdAt   DateTime      @default(now())
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum WorkspacePlan {
  FREE
  TEAM
  ENTERPRISE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum JoinMethod {
  CREATED
  INVITED
  LINK
  DOMAIN
}