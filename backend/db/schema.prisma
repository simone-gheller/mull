// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?        // Make nullable for Google users
  authProvider  AuthProvider   @default(PASSWORD)
  googleId      String?        @unique // Google user ID
  displayName   String?        // Full name from Google/registration
  sessions      Session[]
  createdAt     DateTime       @default(now())
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

model Session {
  sid           String        @id // session ID
  userId        String?       // Link to user
  user          User?         @relation(fields: [userId], references: [id])
  sessionData   Json          // session data stored as JSON
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
}